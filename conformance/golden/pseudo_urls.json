      [
        "http://www.example.com/pages/",
        true
      ],
      [
        "http://www.example.com/pages/my-page",
        true
      ],
      [
        "HTTP://WWW.EXAMPLE.COM/PAGES/X",
        true
      ],
      [
        "http://www.example.com/pages/a/b",
        false
      ],
      [
        "http://wwwXexample.com/pages/",
        false
      ]
    ]
  },
  {
    "purl": "http://www.example.com/search?do[\\x5B]load[\\x5D]=1",
    "matches": [
      [
        "http://www.example.com/search?do[load]=1",
        true
      ],
      [
        "http://www.example.com/search?doXloadX=1",
        false
      ]
    ]
  },
  {
